{
  "name": "@darco2903/workwire",
  "version": "1.0.0",
  "description": "Typed RPC for Web Workers and Node worker_threads, with build-friendly worker URLs.",
  "keywords": [
    "worker",
    "web-worker",
    "worker_threads",
    "rpc",
    "typescript"
  ],
  "author": "Darco2903",
  "license": "MIT",
  "homepage": "https://github.com/Darco2903/workwire#readme",
  "bugs": {
    "url": "https://github.com/Darco2903/workwire/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Darco2903/workwire.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.21.0",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
