{
  "name": "@darco2903/worker-helper",
  "version": "0.1.0",
  "description": "Typed RPC for Web Workers and Node worker_threads, with build-friendly worker URLs.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "worker",
    "web-worker",
    "worker_threads",
    "rpc",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
